{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-dictaphone",
  "version": "2.2.0-beta.1",
  "description": "Transcrire un enregistrement sur la machine, par whisper. Texte, langue reconnue et passages horodatés ; rien n'est envoyé ailleurs.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-dictaphone",
  "repository": "https://github.com/Locaryn/morph-dictaphone",
  "keywords": [
    "dictaphone",
    "voice",
    "speech-to-text",
    "audio",
    "transcription",
    "whisper"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le serveur de transcription audio locale."
    },
    "files.read": {
      "reason": "Lire les enregistrements audio du micro."
    },
    "files.write": {
      "reason": "Écrire les fichiers de transcription temporaires."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "voice-tts",
    "speech-to-text"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "dictaphone-mic-btn",
        "slot": "composer.before_send",
        "order": 10,
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-dictaphone-btn",
        "hint": "Dicter votre message (cliquer pour écouter)"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.2.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.2.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.2.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-dictaphone#v2.2.0-beta.1"
    },
    {
      "version": "2.1.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.1.0",
      "tag": "v2.1.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v2.1.0"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v2.0.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v1.0.0"
    }
  ]
}
