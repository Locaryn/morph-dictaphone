{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-dictaphone",
  "version": "2.5.0-beta.5",
  "description": "Transcrire un enregistrement sur la machine, par whisper, et dicter en direct : le texte s'affiche pendant qu'on parle (Nemotron 3.5 ASR). Rien n'est envoyé ailleurs.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-dictaphone",
  "repository": "https://github.com/Locaryn/morph-dictaphone",
  "keywords": [
    "dictaphone",
    "voice",
    "speech-to-text",
    "audio",
    "transcription",
    "whisper",
    "streaming",
    "nemotron"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le serveur de transcription audio locale."
    },
    "files.read": {
      "reason": "Lire les enregistrements audio du micro."
    },
    "files.write": {
      "reason": "Écrire les fichiers de transcription temporaires."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "gpu": {
    "tools": {
      "transcribe_audio": {}
    }
  },
  "capabilities": [
    "voice-tts",
    "speech-to-text"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "dictaphone-mic-btn",
        "slot": "composer.before_send",
        "order": 10,
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-dictaphone-btn",
        "hint": "Dicter votre message (cliquer pour écouter)"
      },
      {
        "id": "dictaphone-catalogue",
        "slot": "marketplace.catalogs",
        "type": "data",
        "entry": "dist/marketplace.json"
      }
    ]
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.5.0-beta.5",
      "is_beta": true,
      "summary": "Dictée en direct : le texte s'affiche pendant qu'on parle (provisoire atténué, définitif à chaque pause), avec Nemotron 3.5 ASR installé depuis le catalogue ; sans lui, la dictée classique reste en service",
      "tag": "v2.5.0-beta.5",
      "released_at": "2026-11-08",
      "install_source": "Locaryn/morph-dictaphone@v2.5.0-beta.5"
    },
    {
      "version": "2.4.1-beta.1",
      "is_beta": true,
      "summary": "L'onde et l'animation s'affichent (la politique de sécurité de l'hôte bloquait les attributs style) ; un enregistrement ne mélange plus ses morceaux avec le précédent",
      "tag": "v2.4.1-beta.1",
      "released_at": "2026-10-26",
      "install_source": "Locaryn/morph-dictaphone#v2.4.1-beta.1"
    },
    {
      "version": "2.4.0-beta.1",
      "is_beta": true,
      "summary": "Le bouton micro dicte vraiment : onde animée pendant l'écoute, texte écrit dans le champ, installation de whisper au premier usage",
      "tag": "v2.4.0-beta.1",
      "released_at": "2026-10-26",
      "install_source": "Locaryn/morph-dictaphone#v2.4.0-beta.1"
    },
    {
      "version": "2.3.0-beta.1",
      "is_beta": true,
      "summary": "La carte graphique est libérée du modèle de conversation le temps de la transcription si elle manque (appel vérifié à blanc d'abord)",
      "tag": "v2.3.0-beta.1",
      "released_at": "2026-10-10",
      "install_source": "Locaryn/morph-dictaphone#v2.3.0-beta.1"
    },
    {
      "version": "2.2.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.2.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.2.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-dictaphone#v2.2.0-beta.1"
    },
    {
      "version": "2.1.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.1.0",
      "tag": "v2.1.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v2.1.0"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
      "tag": "v2.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v2.0.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
      "tag": "v1.0.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-dictaphone#v1.0.0"
    }
  ]
}
